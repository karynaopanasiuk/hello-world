{
  "$description": "Design tokens from the Figma file 'Published– Design System' (gBv0mWasLtB6BLnyRQ9pw0), read with get_variable_defs on the Notification component. Regenerate CSS with `npm run tokens`.",
  "color": {
    "$type": "color",
    "gray": {
      "100": { "$value": "#f3f5f7", "$description": "Figma: color/gray/100" },
      "300": { "$value": "#8d9097", "$description": "Figma: color/gray/300" }
    },
    "text": {
      "default": { "$value": "#21242e", "$description": "Figma: Text/default" },
      "theme": {
        "$value": "#1b68fa",
        "$description": "Figma: Text/theme. UNRESOLVED: get_variable_defs returned #707996 on the frame and #1b68fa on a variant; #1b68fa is what the design renders."
      }
    },
    "background": {
      "default": { "$value": "#ffffff", "$description": "Figma: Background/default" },
      "theme-filled": {
        "$value": "#1b68fa",
        "$description": "Figma: Background/theme-filled. UNRESOLVED: get_variable_defs returned #00b85c, but the design renders #1b68fa."
      },
      "theme-light": { "$value": "#1b68fa1a", "$description": "Figma: Background/theme-light" }
    },
    "border": {
      "default": { "$value": "#d4dced", "$description": "Figma: Border/default" }
    },
    "neutral": {
      "white": { "$value": "#ffffff", "$description": "Figma: Neutral/white" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "2": { "$value": "8px", "$description": "Figma: Spacing/2" },
    "2xl": { "$value": "24px", "$description": "Figma: Spacing/2XL" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px", "$description": "Figma: Radius/SM" },
    "lg": { "$value": "10px", "$description": "Figma: Radius/LG" }
  },
  "stroke": {
    "$type": "dimension",
    "sm": { "$value": "1px", "$description": "Figma: Stroke/SM" }
  },
  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": {
        "color": "#6f6d7826",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "46px",
        "spread": "-4px"
      },
      "$description": "Figma: Shadow/XS"
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "sm-medium": {
        "$value": { "fontFamily": "Inter Variable", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0px" },
        "$description": "Figma: Body/14 px/SM Medium"
      },
      "sm-regular": {
        "$value": { "fontFamily": "Inter Variable", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0px" },
        "$description": "Figma: Body/14 px/SM Regular"
      },
      "xs-semibold": {
        "$value": { "fontFamily": "Inter Variable", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0px" },
        "$description": "Figma: Body/12 px/XS SemiBold"
      }
    }
  }
}
