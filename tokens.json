{
  "color": {
    "$type": "color",
    "text": {
      "default": { "$value": "#21242e", "$description": "Body text" },
      "theme": { "$value": "#1b68fa", "$description": "Accent text and links" }
    },
    "border": {
      "default": { "$value": "#d4dced", "$description": "Default 1px borders" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" }
  }
}
